    {
      "type": "accordion",
      "field_title": "DrupalX FAQ",
      "field_accordion_item": [
        {
          "type": "accordion_item",
          "field_title": "What is included with DrupalX?",
          "field_body": {
            "value": "<p>DrupalX includes pre-built Layout Builder blocks integrated with a starter theme built on Bootstrap 5. It also features Material Icons and is fully supported by Storybook, providing a comprehensive and cohesive development environment.</p>",
            "format": "full_html"
          }
        },
        {
          "type": "accordion_item",
          "field_title": "How much can I customize?",
          "field_body": {
            "value": "<p>Everything in DrupalX can be customized. You can adjust configurations, modify every Storybook component, and alter or remove any Bootstrap inclusion to suit your specific needs.</p>",
            "format": "full_html"
          }
        },
        {
          "type": "accordion_item",
          "field_title": "Is DrupalX accessible?",
          "field_body": {
            "value": "<p>Yes, DrupalX adheres to WCAG 2.0 AA accessibility guidelines.</p>",
            "format": "full_html"
          }
        },
        {
          "type": "accordion_item",
          "field_title": "Can I see examples of other sites created with DrupalX?",
          "field_body": {
            "value": "<p>Of course. Explore how DrupalX can be used across various types of sites.</p>",
            "format": "full_html"
          },
          "field_link": {
            "uri": "internal:/resources",
            "title": "Read DrupalX articles"
          }
        }
      ]
    },
